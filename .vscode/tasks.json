{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "DB: up",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/db-up.ps1"
            ],
            "problemMatcher": []
        },
        {
            "label": "DB: down",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/db-down.ps1"
            ],
            "problemMatcher": []
        },
        {
            "label": "Backend: run",
            "type": "shell",
            "command": "${env:USERPROFILE}\\tools\\maven\\apache-maven-3.9.6\\bin\\mvn.cmd",
            "args": [
                "-q",
                "-f",
                "edufeed-backend/pom.xml",
                "spring-boot:run"
            ],
            "options": {
                "env": {
                    "JAVA_HOME": "C:/Program Files/Java/jdk-24",
                    "SPRING_FLYWAY_BASELINE_ON_MIGRATE": "true",
                    "SPRING_FLYWAY_BASELINE_VERSION": "0"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "Desktop: run",
            "type": "shell",
            "command": "${env:USERPROFILE}\\tools\\maven\\apache-maven-3.9.6\\bin\\mvn.cmd",
            "args": [
                "-q",
                "-f",
                "edufeed-desktop/pom.xml",
                "-DskipTests",
                "javafx:run"
            ],
            "options": {
                "env": {
                    "JAVA_HOME": "C:/Program Files/Java/jdk-24"
                }
            },
            "problemMatcher": []
        }
    ]
}