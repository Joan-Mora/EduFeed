# Producción (no subir .env.prod real al repo)
# Copia este archivo a .env.prod y rellena secretos.

# PostgreSQL
POSTGRES_DB=edufeed_prod
POSTGRES_USER=edufeed
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432

# pgAdmin (opcional, para ops)
PGADMIN_DEFAULT_EMAIL=ops@example.com
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME
PGADMIN_PORT=5052

# Backend dentro de la red de Docker (usa nombre del servicio db)
DB_URL=jdbc:postgresql://db:5432/edufeed_prod
DB_USER=${POSTGRES_USER}
DB_PASSWORD=${POSTGRES_PASSWORD}
PORT=8080
SPRING_PROFILES_ACTIVE=prod

# Seguridad (rellenar con valores reales y seguros)
JWT_ISSUER=EduFeed
# 32 bytes base64 (ejemplo dummy, cambie por uno generado seguro)
JWT_SECRET=ZmFrZS1zZWNyZXQtMzJiLWxhcmdvLXNlY3JldC1yZW1wbGF6bwo=
# 32 bytes base64 (clave AES-256)
BIOMETRIC_ENCRYPTION_KEY=RELLENAR_BASE64_32B
APP_TIMEZONE=America/Bogota

# Semilla de operador (prod normalmente desactivado)
SEED_OPERATOR_ENABLED=false

# Flyway (normalmente por defecto)
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true
SPRING_FLYWAY_BASELINE_VERSION=0
